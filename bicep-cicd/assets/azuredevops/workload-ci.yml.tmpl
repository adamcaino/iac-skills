# Template: <workload-root>/ci-<workload>.yml
trigger: none

pr:
  branches:
    include:
      - main
  paths:
    include:
      - <workload-root>/**

stages:
  - stage: validate
    displayName: Validate Bicep
    jobs:
      - template: ../../.azuredevops/templates/workload-ci-checks.yml
        parameters:
          workloadPath: <workload-root>
