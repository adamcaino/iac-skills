# Template: .github/workflows/templates/deploy-workload.yml
name: deploy-workload

on:
  workflow_call:
    inputs:
      environment_name:
        required: true
        type: string
      workload_path:
        required: true
        type: string
      parameter_file:
        required: true
        type: string

jobs:
  deploy:
    name: Deploy ${{ inputs.environment_name }}
    runs-on: ubuntu-latest
    environment: ${{ inputs.environment_name }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Azure login
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Deploy subscription-scope Bicep
        shell: bash
        run: |
          az deployment sub create \
            --name "${{ inputs.environment_name }}-${{ github.run_id }}" \
            --location "${{ vars.AZURE_DEPLOYMENT_LOCATION }}" \
            --template-file "${{ inputs.workload_path }}/main.bicep" \
            --parameters "${{ inputs.parameter_file }}"
